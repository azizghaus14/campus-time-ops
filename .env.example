# ---- Google Cloud ----
GCP_PROJECT=your-hackathon-project
REGION=asia-southeast1

# ---- Data ----
# snapshot = read committed pseudonymised snapshot (default, offline-safe)
# live     = re-fetch the public APU feed at startup, fall back to snapshot on any error
DATA_MODE=snapshot
# Fixed "now" for reproducible demos (ISO, MYT). Leave empty to use the real clock.
DEMO_NOW=2026-11-12T09:00:00+08:00
# Last day of the current teaching term (assumption, used for attendance forecasts)
TERM_END=2026-12-18

# ---- Policy knobs (see grounding/campus_ops_policy.md) ----
ATTENDANCE_THRESHOLD=0.80
NOTICE_HOURS=24
SHUTTLE_BUFFER_MIN=15
# false = make-up classes must end before the last *regular* shuttle (excludes "limited space" trips)
SHUTTLE_INCLUDE_LIMITED=false

# ---- State store ----
# json = local JSON files under data/state (default); firestore = Google Cloud Firestore
STORE_BACKEND=json
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ---- Workspace actions ----
# local  = write .ics / .eml / markdown into data/outbox and serve them from the API (offline demo)
# google = real Google Calendar / Gmail drafts / Docs on the DEMO Workspace domain only
WORKSPACE_MODE=local
WORKSPACE_DEMO_DOMAIN=demo.example.edu
# Path to an OAuth token JSON (authorized_user) for the demo admin account. In Cloud Run, mount from Secret Manager.
GOOGLE_OAUTH_TOKEN_FILE=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CHANGELOG_DOC_ID=

# ---- Gemini (ADK fallback agents) ----
GEMINI_MODEL=gemini-2.5-pro
GOOGLE_GENAI_USE_VERTEXAI=true

# ---- MCP security ----
MCP_AUTH_TOKEN=change-me-long-random-string
RATE_LIMIT_PER_MIN=120

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
